<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>6</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Mz.Storage.SourceCopyValidation</AssemblyName>
    <RootNamespace>Mz.Storage.SourceCopyValidation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SpaceEngineersBin64>E:\SteamLibrary\steamapps\common\SpaceEngineers\Bin64</SpaceEngineersBin64>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Mz.SemanticVersioning\*.cs" Link="Libraries\Mz.SemanticVersioning\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Mz.Storage.Core\*.cs" Link="Libraries\Mz.Storage.Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Mz.Storage.SpaceEngineers\*.cs" Link="Libraries\Mz.Storage.SpaceEngineers\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Sandbox.Common">
      <HintPath>$(SpaceEngineersBin64)\Sandbox.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(SpaceEngineersBin64)\VRage.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
