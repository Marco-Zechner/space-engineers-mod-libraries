<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>6</LangVersion>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <AssemblyName>Mz.TextTemplate.SourceCopyValidation</AssemblyName>
    <RootNamespace>Mz.TextTemplate.SourceCopyValidation</RootNamespace>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\Mz.TextTemplate\**\*.cs"
      Exclude="..\..\src\Mz.TextTemplate\bin\**;..\..\src\Mz.TextTemplate\obj\**"
      Link="Libraries\Mz.TextTemplate\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Mal.Mdk2.ModAnalyzers"
      Version="2.1.16"
      PrivateAssets="all" />
  </ItemGroup>

</Project>